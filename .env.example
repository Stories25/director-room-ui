# Runway Characters API — server-side only, never exposed to client
# Get your key at dev.runwayml.com
RUNWAYML_API_SECRET=key_your_runway_api_secret_here

# OpenAI-compatible LLM endpoint — used for transcript formatting and story extraction
OPENAI_API_KEY=sk-your_openai_api_key_here
OPENAI_BASE_URL=https://opencode.ai/zen/v1
OPENAI_MODEL=gpt-5.5

# Runway avatar ID — create your character at dev.runwayml.com/characters
# Safe to expose (NEXT_PUBLIC prefix), it's just an identifier
NEXT_PUBLIC_AVATAR_ID=your-avatar-uuid-here

# Argon backend — hardcoded auth token for the pipeline
ARGON_BASE_URL=https://argon-1046193468052.asia-south1.run.app
ARGON_AUTH_TOKEN=your_argon_jwt_token_here

# Argon — browser-side (NEXT_PUBLIC) for client-driven pipeline
NEXT_PUBLIC_ARGON_BASE_URL=https://argon-1046193468052.asia-south1.run.app
NEXT_PUBLIC_ARGON_AUTH_TOKEN=your_argon_jwt_token_here
